# Пример настроек. Скопируйте в .env и впишите свои ключи; .env в git не попадает.
# Переменные окружения важнее значений из файла. Закомментированные строки — значения по умолчанию.

# --- VLM: описание внешности, марка/модель по фото (необязательно) ---
# Ключ OpenRouter (https://openrouter.ai). Без ключа пайплайн работает, поля VLM остаются пустыми.
OPENROUTER_API_KEY=
# Основная и запасная модели OpenRouter.
#OPENROUTER_MODEL=anthropic/claude-sonnet-5
#OPENROUTER_FALLBACK=google/gemini-3.5-flash

# Прямой доступ к Anthropic API (вместо OpenRouter).
#ANTHROPIC_API_KEY=
#VLM_MODEL=claude-opus-5
# Глубина рассуждений: low / medium / high.
#VLM_EFFORT=low

# Провайдер: auto (что найдётся) / openrouter / anthropic.
#VLM_PROVIDER=auto
# auto — включить при наличии ключа; on — всегда; off — не использовать.
#VLM_ENABLED=auto

# --- Реестр data.egov.kz: марка/модель/год по госномеру ---
# Ключ API необязателен: без него поиск идёт тем же запросом, что и на сайте.
#EGOV_API_KEY=
# on — искать номер в реестре, off — не обращаться к сети.
#REGISTRY_ENABLED=on

# --- Пути и детектор (необязательно) ---
# Папка с кадрами камеры (по умолчанию «фото машин на взевшивании/Auto» в корне проекта).
#DATA_DIR=
# Куда складывать размеченные кадры, JSON, CSV и базу (по умолчанию results/).
#RESULTS_DIR=
#YOLO_MODEL=yolov8s.pt
#YOLO_IMGSZ=1280

# --- Веб-сервер ---
#HOST=127.0.0.1
#PORT=8000
